ze=(8,5))\n\nsns.barplot(\n    data=results,\n    x='Model',\n    y='Accuracy',\n    palette='viridis'\n)\n\nplt.title('Model Accuracy Comparison')\n\nplt.show()\n\n# =========================\n# RANDOM FOREST REPORT\n# =========================\n\nprint(\"\\nClassification Report\\n\")\n\nprint(\n    classification_report(\n        y_test,\n        rf_pred\n    )\n)\n\n# =========================\n# CONFUSION MATRIX\n# =========================\n\nplt.figure(figsize=(8,6))\n\ncm = confusion_matrix(\n    y_test,\n    rf_pred\n)\n\nsns.heatmap(\n    cm,\n    annot=True,\n    fmt='d',\n    cmap='Blues'\n)\n\nplt.title(\n    'Random Forest Confusion Matrix'\n)\n\nplt.show()\n\n# =========================\n# MULTICLASS ROC AUC\n# =========================\n\nrf_probs = rf.predict_proba(X_test)\n\nauc_score = roc_auc_score(\n    y_test,\n    rf_probs,\n    multi_class='ovr',\n    average='weighted'\n)\n\nprint(\"\\nWeighted ROC-AUC Score:\",\n      round(auc_score,4))\n\n# =========================\n# FEATURE IMPORTANCE\n# =========================\n\nimportance = pd.DataFrame({\n\n    'Feature': X.columns,\n\n    'Importance':\n    rf.feature_importances_\n\n})\n\nimportance = importance.sort_values(\n    by='Importance',\n    ascending=False\n)\n\nprint(\"\\nTop 15 Important Features\")\n\nprint(\n    importance.head(15)\n)\n\nplt.figure(figsize=(12,8))\n\nsns.barplot(\n    data=importance.head(15),\n    x='Importance',\n    y='Feature',\n    palette='magma'\n)\n\nplt.title(\n    'Top 15 Important Features'\n)\n\nplt.show()\n\n# =========================\n# FINAL RESULTS\n# =========================\n\nprint(\"\\n================================\")\n\nprint(\"Logistic Regression :\", round(lr_acc,4))\nprint(\"Decision Tree       :\", round(dt_acc,4))\nprint(\"Random Forest       :\", round(rf_acc,4))\nprint(\"ROC-AUC Score       :\", round(auc_score,4))\n\nprint(\"================================\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-