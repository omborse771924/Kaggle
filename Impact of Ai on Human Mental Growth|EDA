===============================================\n# DATASET OVERVIEW\n# ==========================================================\n\nprint(df.shape)\nprint(df.info())\ndisplay(df.head())\n\n# ==========================================================\n# OUTCOME LABEL DISTRIBUTION\n# ==========================================================\n\nplt.figure(figsize=(10,6))\n\nsns.countplot(\n    x='Outcome_Label',\n    data=df,\n    palette='viridis'\n)\n\nplt.title(\"Outcome Label Distribution\", fontsize=18)\nplt.show()\n\n# ==========================================================\n# ERA DISTRIBUTION\n# ==========================================================\n\nplt.figure(figsize=(10,6))\n\nsns.countplot(\n    x='Era',\n    data=df,\n    palette='Set2'\n)\n\nplt.title(\"Era Distribution\")\nplt.show()\n\n# ==========================================================\n# REGION DISTRIBUTION\n# ==========================================================\n\nplt.figure(figsize=(14,6))\n\nsns.countplot(\n    y='Region',\n    data=df,\n    order=df['Region'].value_counts().index,\n    palette='tab20'\n)\n\nplt.title(\"Region Distribution\")\nplt.show()\n\n# ==========================================================\n# EDUCATION LEVEL\n# ==========================================================\n\nplt.figure(figsize=(12,6))\n\nsns.countplot(\n    x='Education_Level',\n    data=df,\n    palette='coolwarm'\n)\n\nplt.xticks(rotation=45)\nplt.title(\"Education Level Distribution\")\nplt.show()\n\n# ==========================================================\n# TOP PROFESSIONS\n# ==========================================================\n\nplt.figure(figsize=(14,8))\n\ntop_prof = df['Profession'].value_counts().head(20)\n\nsns.barplot(\n    x=top_prof.values,\n    y=top_prof.index,\n    palette='Spectral'\n)\n\nplt.title(\"Top 20 Professions\")\nplt.show()\n\n# ==========================================================\n# AI TOOL CATEGORY\n# ==========================================================\n\nplt.figure(figsize=(12,6))\n\nsns.countplot(\n    y='AI_Tool_Category',\n    data=df,\n    order=df['AI_Tool_Category'].value_counts().index,\n    palette='Paired'\n)\n\nplt.title(\"AI Tool Categories\")\nplt.show()\n\n# ==========================================================\n# NUMERICAL FEATURES DISTRIBUTION\n# ==========================================================\n\nnum_cols = [\n'Weekly_AI_Usage_Hours',\n'AI_Dependency_Score',\n'Human_Creativity_Score',\n'Critical_Thinking_Ability',\n'Problem_Solving_Skills',\n'Emotional_Intelligence',\n'Innovation_Rate',\n'Learning_Speed',\n'Human_Decision_Making_Involvement',\n'Social_Interaction_Quality',\n'Cognitive_Load_Index',\n'Mental_Wellbeing_Score',\n'AI_Tool_Proficiency',\n'Adaptability_Score',\n'Attention_Span_Minutes'\n]\n\ncolors = [\n'red','blue','green','purple',\n'orange','brown','cyan','magenta',\n'gold','teal','navy','pink',\n'olive','lime','coral'\n]\n\nfor col,color in zip(num_cols,colors):\n\n    plt.figure(figsize=(10,5))\n\n    sns.histplot(\n        df[col],\n        bins=30,\n        kde=True,\n        color=color\n    )\n\n    plt.title(f\"Distribution of {col}\")\n    plt.show()\n\n# ==========================================================\n# BOXPLOTS FOR OUTLIERS\n# ==========================================================\n\nfor col,color in zip(num_cols,colors):\n\n    plt.figure(figsize=(10,2))\n\n    sns.boxplot(\n        x=df[col],\n        color=color\n    )\n\n    plt.title(f\"Outliers in {col}\")\n    plt.show()\n\n# ==========================================================\n# CORRELATION HEATMAP\n# ==========================================================\n\nplt.figure(figsize=(16,10))\n\nsns.heatmap(\n    df[num_cols].corr(),\n    annot=True,\n    cmap='RdYlBu',\n    linewidths=0.5\n)\n\nplt.title(\"Correlation Heatmap\")\nplt.show()\n\n# ==========================================================\n# AI DEPENDENCY VS CREATIVITY\n# =====================