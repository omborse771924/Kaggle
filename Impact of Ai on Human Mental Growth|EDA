ducation_Level',\n    hue='Outcome_Label',\n    data=df,\n    palette='husl'\n)\n\nplt.xticks(rotation=45)\nplt.title(\"Education Level vs Outcome\")\nplt.show()\n\n# ==========================================================\n# REGION VS OUTCOME\n# ==========================================================\n\nplt.figure(figsize=(14,6))\n\nsns.countplot(\n    x='Region',\n    hue='Outcome_Label',\n    data=df,\n    palette='Accent'\n)\n\nplt.xticks(rotation=45)\nplt.title(\"Region vs Outcome\")\nplt.show()\n\n# ==========================================================\n# AI TOOL CATEGORY VS OUTCOME\n# ==========================================================\n\nplt.figure(figsize=(14,6))\n\nsns.countplot(\n    y='AI_Tool_Category',\n    hue='Outcome_Label',\n    data=df,\n    palette='Set2'\n)\n\nplt.title(\"AI Tool Category vs Outcome\")\nplt.show()\n\n# ==========================================================\n# POSITIVE EFFECTS OF AI\n# ==========================================================\n\nplt.figure(figsize=(14,6))\n\nsns.countplot(\n    y='Positive_Effects_of_AI',\n    data=df,\n    order=df['Positive_Effects_of_AI'].value_counts().head(15).index,\n    palette='Greens'\n)\n\nplt.title(\"Top Positive Effects of AI\")\nplt.show()\n\n# ==========================================================\n# NEGATIVE EFFECTS OF AI\n# ==========================================================\n\nplt.figure(figsize=(14,6))\n\nsns.countplot(\n    y='Negative_Effects_of_AI',\n    data=df,\n    order=df['Negative_Effects_of_AI'].value_counts().head(15).index,\n    palette='Reds'\n)\n\nplt.title(\"Top Negative Effects of AI\")\nplt.show()\n\nprint(\"Detailed EDA Completed Successfully\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-30T17:55:03.215489Z","iopub.execute_input":"2026-05-30T17:55:03.216439Z","iopub.status.idle":"2026-05-30T17:55:25.266072Z","shell.execute_reply.started":"2026-05-30T17:55:03.216403Z","shell.execute_reply":"2026-05-30T